---
const { pathname } = Astro.url;
const isSession = pathname.startsWith('/session');
const isMethod = pathname.startsWith('/method');
const isWriting = pathname.startsWith('/posts');
---

<header class="topbar">
  <a href="/" class="brand">Всеволод Викулин</a>
  <nav>
    <a href="/session/" class={isSession ? 'active' : ''}>Сессия</a>
    <a href="/method/" class={isMethod ? 'active' : ''}>Метод</a>
    <a href="/posts/" class={isWriting ? 'active' : ''}>Статьи</a>
  </nav>
</header>
