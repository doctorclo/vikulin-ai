---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import { Content } from '../texts/strategy.md';
---

<BaseLayout
  title="Нормальная AI-стратегия"
  description="Продукт для руководителей: за 2–3 недели находим ключевые процессы, где AI даст максимальный эффект, обучаем управленческую команду и собираем план быстрых побед на 3–6 месяцев."
>
  <Topbar />

  <article>
    <header class="article-header">
      <div class="eyebrow">Продукт для руководителей</div>
      <h1>Нормальная <span class="nowrap">AI-стратегия</span></h1>
      <div class="meta">2–3 недели · глубокая работа с ключевыми руководителями · конкретный план действий вместо талмуда на 150 слайдов</div>
      <p class="session-top-cta"><a href="#contacts">Написать мне →</a></p>
    </header>

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
