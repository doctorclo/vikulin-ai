---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import SessionBanner from '../components/SessionBanner.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatDate = (date: Date) => {
  const months = ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
};
---

<BaseLayout title="Всеволод Викулин — Нормальный AI, а не бесконечные пилоты" description="10 лет внедряю искусственный интеллект в крупный российский бизнес. Помогаю компаниям сделать AI системной бизнес-функцией.">
  <Topbar />

  <h1 class="page-eyebrow">Нормальный AI, а не бесконечные пилоты</h1>

  <section class="intro">
    <p>
      Сегодня вокруг искусственного интеллекта все сходят с ума, но каждый <span class="nowrap">по-своему</span>.
      Быстро делают прототипы, которые красиво выглядят на демо, но галлюцинируют
      на реальных задачах. Прикручивают нейросети к процессам, которые вообще нужно было давно закопать.
      Просят бюджеты на эксперименты&nbsp;— просто из любопытства. Либо оцепенели и не делают с AI
      вообще ничего.
    </p>
    <p>
      В результате команда либо парализована, либо отправляет деньги в бесконечную чёрную дыру.
    </p>
    <p>
      Я помогаю руководителям остановить хаос и превратить AI в понятный <span class="nowrap">бизнес-эффект</span>.
    </p>
    <ul class="intro-list">
      <li><strong>Отсекаем разрозненные пилоты.</strong> Не распыляемся на множество инициатив, а находим главные источники эффекта от искусственного интеллекта.</li>
      <li><strong>Переизобретаем ключевые <span class="nowrap">бизнес-процессы</span>.</strong> Не посыпаем их <span class="nowrap">«AI-пылью»</span>, а представляем, как построили бы их с нуля сегодня.</li>
      <li><strong>Запускаем через быстрые победы вашей команды.</strong> Без многолетнего долгостроя. И&nbsp;без иллюзии, что внешний вендор сделает трансформацию за вас.</li>
    </ul>
    <p class="home-more"><a href="/method/">Подробнее о моём методе →</a></p>
  </section>

  <hr class="divider" />

  <section class="home-about">
    <h2 class="section-label">Обо мне</h2>
    <p>
      Я 10 лет руковожу созданием и внедрением AI-систем в крупнейших технологических
      компаниях России. Пропустил через себя сотни проектов и точно знаю разницу между демо
      для руководителей и промышленной системой под высокой нагрузкой:
    </p>
    <div class="home-cv">
      <span class="home-cv-co">Т-Банк</span><span>Руковожу внедрением <span class="nowrap">AI-агентов</span></span>
      <span class="home-cv-co">Яндекс</span><span>Отвечал за релиз Алисы в Поиске</span>
      <span class="home-cv-co">VK</span><span>Руководил NLP-разработкой голосового ассистента</span>
    </div>
    <p>
      Я не продаю разработку или серверы — поэтому мне не нужно «впаривать» вам внедрение
      там, где оно не окупится. Если AI вам не нужен, я скажу об этом прямо на первом звонке.
    </p>
    <p class="home-more"><a href="/about/">Подробнее обо мне →</a></p>
  </section>

  <hr class="divider" />

  <section class="home-start">
    <h2 class="section-label">С чего начинаем работу</h2>
    <SessionBanner />
  </section>

  <hr class="divider" />

  <section id="articles">
    <h2 class="section-label">Статьи</h2>

    {posts.length === 0 ? (
      <p style="color: var(--color-text-secondary); font-size: 14px;">
        Пока пусто. Скоро первая статья.
      </p>
    ) : (
      <div class="posts-list">
        {posts.map((post) => (
          <>
            <span class="post-date">{formatDate(post.data.date)}</span>
            <a href={`/posts/${post.slug}/`} class="post-title">
              {post.data.title}
            </a>
          </>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
