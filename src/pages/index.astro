---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime()
);

const formatDate = (date: Date) => {
  const months = ['янв', 'фев', 'мар', 'апр', 'май', 'июн', 'июл', 'авг', 'сен', 'окт', 'ноя', 'дек'];
  return `${date.getDate()} ${months[date.getMonth()]} ${date.getFullYear()}`;
};
---

<BaseLayout title="Всеволод Викулин">
  <Topbar />

  <section class="intro">
    <p>
      В AI легко собрать демку: взять готовую LLM, прикрутить красивый интерфейс
      и показать на презентации магию. На этом у большинства компаний эффект от AI
      и заканчивается. Превратить демку в актив, который приносит прибыль,
      несоизмеримо сложнее.
    </p>
    <p>
      Я помогаю компаниям перестать запускать бесконечные пилоты и сделать AI
      системной бизнес-функцией. Сначала отвечаем на главный вопрос: стоит ли
      вообще инвестировать в AI сейчас. Если да, выстраиваем остальное:
      AI-стратегию, приоритизацию кейсов, компетенции команды и инфраструктуру.
    </p>
    <p>
      Я 10 лет внедряю AI в крупных компаниях. Руководил NLP-разработкой
      ассистента в VK, отвечал за релиз Алисы в Поиске Яндекса, сейчас руковожу
      внедрением AI-агентов в Т-Банке.
    </p>
  </section>

  <section class="offer">
    <div class="offer-title">Стратегическая сессия для руководителей</div>
    <div class="offer-meta">Онлайн или офлайн</div>
    <p>
      В первой части на реальных кейсах показываю, где лежит основная ценность AI.
      Во второй вместе строим дорожную карту к ней на задачах вашей компании.
    </p>
    <p>
      <a href="https://t.me/vsevolod_vikulin">Напишите мне</a> — обсудим и поймём,
      нужно ли вам уже строить эту бизнес-функцию.
    </p>
  </section>

  <hr class="divider" />

  <section id="articles">
    <h2 class="section-label">Статьи</h2>

    {posts.length === 0 ? (
      <p style="color: var(--color-text-secondary); font-size: 14px;">
        Пока пусто. Скоро первая статья.
      </p>
    ) : (
      <div class="posts-list">
        {posts.map((post) => (
          <>
            <span class="post-date">{formatDate(post.data.date)}</span>
            <a href={`/posts/${post.slug}/`} class="post-title">
              {post.data.title}
            </a>
          </>
        ))}
      </div>
    )}
  </section>

  <hr class="divider" />

  <section id="contacts">
    <h2 class="section-label">Контакты</h2>

    <div class="contacts">
      <span class="key">Канал</span>
      <a href="https://t.me/vikulin_ai">t.me/vikulin_ai</a>

      <span class="key">Telegram</span>
      <a href="https://t.me/vsevolod_vikulin">t.me/vsevolod_vikulin</a>

      <span class="key">Email</span>
      <a href="mailto:va.vikulin@yandex.ru">va.vikulin@yandex.ru</a>
    </div>
  </section>

  <div class="footer">© {new Date().getFullYear()} Всеволод Викулин</div>
</BaseLayout>
