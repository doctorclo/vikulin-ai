---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import { Content } from '../texts/session.md';
---

<BaseLayout
  title="Стратегическая сессия по AI-трансформации"
  description="Стратегическая сессия для команды руководителей: где AI даёт вашему бизнесу преимущество и как сделать его системной бизнес-функцией."
>
  <Topbar />

  <article>
    <header class="article-header">
      <div class="eyebrow">Сессия</div>
      <h1>Стратегическая сессия по AI-трансформации</h1>
      <div class="meta">1–2 дня · онлайн или офлайн · для команды руководителей</div>
    </header>

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
