---
import BaseLayout from '../layouts/BaseLayout.astro';
import Topbar from '../components/Topbar.astro';
import { Content } from '../texts/about.md';
---

<BaseLayout
  title="Обо мне — Всеволод Викулин"
  description="10 лет внедряю AI в крупнейших российских технологических компаниях: VK, Яндекс, Т-Банк. Преподаю в ВШЭ."
>
  <Topbar />

  <article>
    <h1 class="page-eyebrow">Обо мне</h1>

    <figure class="about-photo">
      <img
        src="/images/about/stage.jpg"
        alt="Всеволод Викулин выступает на GigaConf"
        width="1137"
        height="853"
      />
      <figcaption>Выступление на GigaConf, 2026</figcaption>
    </figure>

    <div class="article-content">
      <Content />
    </div>
  </article>
</BaseLayout>
